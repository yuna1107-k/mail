# /etc/systemd/system/mail-forwarder.service
# YOUR_USER を Raspberry Pi のユーザー名に置き換えてから配置してください。
[Unit]
Description=University mail forwarder (IMAP -> SMTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/mail-forwarder
ExecStart=/usr/bin/python3 /home/YOUR_USER/mail-forwarder/forwarder.py --config /home/YOUR_USER/mail-forwarder/config.ini
Restart=on-failure
RestartSec=60
# ログイン失敗（終了コード 2）のときは再起動しない（アカウントのロック防止）
RestartPreventExitStatus=2
Environment=PYTHONUNBUFFERED=1

# 守り：書き込めるのは mail-forwarder フォルダだけ
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/YOUR_USER/mail-forwarder

[Install]
WantedBy=multi-user.target
